# GEMINI_API_KEY: Optional fallback if cloud AI is permitted by security policy.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# --- QARVYEN 2.0 SOVEREIGN CONFIGURATION ---

# SOVEREIGN ENCLAVE MODE: true = no cloud telemetry, strict on-premise execution
VITE_SOVEREIGN_MODE="true"

# LOCAL LLM (Ollama / Local Inference Server)
VITE_OLLAMA_BASE_URL="http://127.0.0.1:11434"
VITE_OLLAMA_MODEL="qwen2.5:7b"

# COPERNICUS DATA SPACE ECOSYSTEM (CDSE) CREDENTIALS & OPENEO
# Used for Sentinel-1 GRD IW retrieval and openEO batch jobs
COPERNICUS_OPENEO_ENDPOINT="https://openeo.dataspace.copernicus.eu/v1.2"
COPERNICUS_CDSE_CLIENT_ID=""
COPERNICUS_CDSE_CLIENT_SECRET=""
OPENEO_AUTH_URL="https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token"

# WORLDPOP RASTER DATA (School of Geography, University of Southampton)
WORLDPOP_DATA_DIR="./data/real/worldpop"
WORLDPOP_DOWNLOAD_URL="https://data.worldpop.org/GIS/Population/Global_2020_2026/2024/SEN/sen_ppp_2024_UNadj_constrained.tif"

# OPENSTREETMAP / OVERPASS API
OSM_OVERPASS_ENDPOINT="https://overpass-api.de/api/interpreter"
OSM_OVERPASS_FALLBACK_ENDPOINT="https://lz4.overpass-api.de/api/interpreter"
OSM_CACHE_DIR="./data/real/osm"

# REAL DATA STORAGE ROOT
REAL_DATA_STORAGE_ROOT="./data/real"

# HARDWARE ACCELERATION TARGET (auto | cuda | rocm | metal | cpu)
QARVYEN_ACCELERATION_BACKEND="auto"
QARVYEN_DEVICE_ID="auto"

# SECURITY & AUDIT
QARVYEN_SECRET_KEY=""
QARVYEN_AUDIT_LOG_PATH="./audit.jsonl"
QARVYEN_SECURITY_CLEARANCE_DEFAULT="CONFIDENTIEL_DEFENSE"


